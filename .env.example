APP_NAME=Alignment Memory
APP_MODE=fixture
ENVIRONMENT=development
DATABASE_URL=<set-in-secret-store>
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
INTERNAL_HMAC_SECRET=<set-in-secret-store>
GITHUB_APP_ID=<set-in-secret-store>
GITHUB_APP_PRIVATE_KEY=<set-in-secret-store>
GITHUB_SYNC_WORKFLOW=alignment-analyze.yml
OPENROUTER_API_KEY=<set-in-secret-store>
OPENROUTER_PRIMARY_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
